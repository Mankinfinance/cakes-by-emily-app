# Copy this file to .env.local for local development, and add the same
# values in Vercel (Project, Settings, Environment Variables) for the live site.
# Never commit real values. .env.local is ignored by git.

# The public address of the site, e.g. https://cakesbyemily.com.au
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings, API). The anon key is safe in the browser.
# The service role key is secret: server only, never share it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Who can sign in to /admin (comma separated). Must match their Supabase Auth email.
ADMIN_EMAILS=
# Two-factor sign in for admin. Leave as true.
ADMIN_REQUIRE_MFA=true
# Where new order alerts go.
ADMIN_NOTIFY_EMAIL=

# Stripe (Developers, API keys). Use sk_test_... until you are ready to go live.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in Stripe (Developers, Webhooks), starts with whsec_
STRIPE_WEBHOOK_SECRET=

# Resend (API Keys). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Cakes by Emily <orders@your-domain.com.au>"

# A long random string used to build private order links and voucher codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Do not change it after launch, or existing order links stop working and voucher codes can no longer be re-sent.
ORDER_LINK_SECRET=

# A long random string that Vercel Cron sends to the reminders job.
CRON_SECRET=

# Optional: a review link (for example a Google review URL) for the thank-you email.
# Emily can also set this in /admin/settings, which takes priority.
REVIEW_URL=

# Pickup address and parking note sent before pickup.
PICKUP_DETAILS="[Emily to add pickup address and parking note]"

# Local testing only. Never set these on Vercel.
# DATA_ADAPTER=memory
# E2E_AUTH_BYPASS=1
